{
  "name": "presbuilder",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Анимированные ролики из текста озвучки: редактор + сцены, которые пишет ИИ-агент (Claude Code, Codex)",
  "license": "MIT",
  "repository": "github:xaidan777/PressBuilder",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "new": "node tools/new.mjs",
    "check": "node tools/check.mjs",
    "timing": "node tools/timing.mjs",
    "start:cloud": "node server/cloud.mjs",
    "test:cloud": "node --test tests/cloud-*.test.mjs",
    "check:media": "node tools/inspect-p05-media.mjs",
    "check:media:list": "node tools/inspect-p05-media.mjs --list",
    "check:media:self-test": "node tools/inspect-p05-media.mjs --self-test",
    "measure:media": "node tools/measure-m58-performance.mjs",
    "measure:p05": "node tools/measure-p05-assembly.mjs",
    "measure:p05:compare": "node tools/compare-p05-profiles.mjs",
    "measure:p13": "node tools/compare-p13-single-edit.mjs",
    "check:p05:voice-music": "node tools/check-p05-known-voice-music.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "dependencies": {
    "@preact/signals": "^2.11.2",
    "preact": "^10.29.8"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.2.0"
  }
}
