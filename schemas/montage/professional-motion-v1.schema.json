{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pressbuilder.local/schemas/montage/professional-motion-v1.schema.json",
  "title": "P18 deterministic bounded keyframe motion preview request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "scene_id",
    "source_sha256",
    "expected_revision",
    "frame_rate",
    "duration_frames",
    "reduced_motion",
    "tracks"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project_id": {
      "$ref": "#/$defs/slug"
    },
    "scene_id": {
      "$ref": "#/$defs/slug"
    },
    "source_sha256": {
      "$ref": "#/$defs/sha"
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0
    },
    "frame_rate": {
      "$ref": "#/$defs/fps"
    },
    "duration_frames": {
      "type": "integer",
      "minimum": 4,
      "maximum": 1800
    },
    "reduced_motion": {
      "type": "boolean"
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/track"
      }
    },
    "sample_frames": {
      "type": "array",
      "minItems": 2,
      "maxItems": 120,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1800
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,40}$"
    },
    "sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "fps": {
      "type": "object",
      "required": [
        "num",
        "den"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "num": {
              "const": 24
            },
            "den": {
              "const": 1
            }
          }
        },
        {
          "properties": {
            "num": {
              "const": 25
            },
            "den": {
              "const": 1
            }
          }
        },
        {
          "properties": {
            "num": {
              "const": 30
            },
            "den": {
              "const": 1
            }
          }
        },
        {
          "properties": {
            "num": {
              "const": 60
            },
            "den": {
              "const": 1
            }
          }
        },
        {
          "properties": {
            "num": {
              "const": 24000
            },
            "den": {
              "const": 1001
            }
          }
        },
        {
          "properties": {
            "num": {
              "const": 30000
            },
            "den": {
              "const": 1001
            }
          }
        }
      ]
    },
    "track": {
      "type": "object",
      "required": [
        "target_id",
        "property",
        "keyframes"
      ],
      "additionalProperties": false,
      "properties": {
        "target_id": {
          "$ref": "#/$defs/slug"
        },
        "property": {
          "enum": [
            "x",
            "y",
            "scale",
            "rotation_rad",
            "camera_yaw",
            "camera_zoom",
            "opacity",
            "blur_px"
          ]
        },
        "keyframes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/keyframe"
          }
        }
      }
    },
    "keyframe": {
      "type": "object",
      "required": [
        "frame",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "frame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1800
        },
        "value": {
          "type": "number"
        },
        "easing": {
          "enum": [
            "linear",
            "smoothstep",
            "cubic_in_out"
          ]
        }
      }
    }
  },
  "description": "Code enforces exact keyframe order and coverage, per-property acceleration and velocity, frame budget, unique target/property pairs and no publication; schema alone does not attest P08 sources or media rendering."
}
