{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pressbuilder.local/schemas/montage/qc-cockpit-v1.schema.json",
  "title": "M51 source-pinned read-only timecoded QC event projection",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "release_id",
    "release_sha256",
    "timebase",
    "scenes",
    "events",
    "stale_version_events_ignored",
    "duration_estimated_tick",
    "actual_duration_s",
    "release_qa_verdict",
    "unlocated_qa_alerts",
    "unresolved_review_events",
    "warnings",
    "render_allowed",
    "publication_allowed",
    "snapshot_sha256"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project_id": {
      "type": "string"
    },
    "release_id": {
      "type": "string"
    },
    "release_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "timebase": {
      "type": "object",
      "properties": {
        "ticks_per_second": {
          "const": 240000
        },
        "fps": {
          "type": "object",
          "properties": {
            "num": {
              "type": "integer"
            },
            "den": {
              "type": "integer"
            },
            "frame_ticks": {
              "type": "integer"
            }
          }
        }
      },
      "required": [
        "ticks_per_second",
        "fps"
      ]
    },
    "scenes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "scene_id",
          "source_sha256",
          "source_version_id",
          "source_approved_revision",
          "start_frame",
          "end_frame",
          "start_tick",
          "end_tick",
          "duration_declared_s",
          "transition_after",
          "review_revision",
          "located_events"
        ],
        "properties": {
          "scene_id": {
            "type": "string"
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "start_tick": {
            "type": "integer",
            "minimum": 0
          },
          "end_tick": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "events": {
      "type": "array",
      "maxItems": 2300,
      "items": {
        "type": "object",
        "required": [
          "id",
          "source",
          "release_sha256",
          "scene_id",
          "issue_code",
          "severity",
          "disposition",
          "message",
          "global_seconds",
          "global_frame",
          "global_pts_tick",
          "evidence_available",
          "location",
          "requires_human_review"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "source": {
            "enum": [
              "P07_REVIEW",
              "P05_OUTPUT_QA_UNTIMED"
            ]
          },
          "release_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "scene_id": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "issue_code": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "disposition": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "global_seconds": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "global_frame": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "global_pts_tick": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence_available": {
            "type": "boolean"
          },
          "location": {
            "enum": [
              "EXACT_REVIEW_TIMECODE",
              "UNLOCATED_TECHNICAL_ISSUE"
            ]
          },
          "requires_human_review": {
            "type": "boolean"
          }
        }
      }
    },
    "stale_version_events_ignored": {
      "type": "integer",
      "minimum": 0
    },
    "duration_estimated_tick": {
      "type": "integer",
      "minimum": 0
    },
    "actual_duration_s": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "release_qa_verdict": {
      "const": "PASS"
    },
    "unlocated_qa_alerts": {
      "type": "integer",
      "minimum": 0
    },
    "unresolved_review_events": {
      "type": "integer",
      "minimum": 0
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "m58_audio_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "source", "evidence_basis", "release_sha256",
        "findings", "analysis_verified_for_customer_media", "human_listening_verified",
        "publication_allowed"],
      "properties": {
        "state": {"enum": ["NOT_CONNECTED", "REJECTED", "SYNTHETIC_REVIEW_ONLY"]},
        "source": {"const": "M58_R19_STEREO_PCM_SYNTHETIC"},
        "evidence_basis": {"type": "string"},
        "release_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "fixture_only": {"const": true},
        "analysis_verified_for_customer_media": {"const": false},
        "human_listening_verified": {"const": false},
        "publication_allowed": {"const": false},
        "findings": {
          "type": "array", "maxItems": 42,
          "items": {"type": "object", "additionalProperties": false,
            "required": ["id","scene_id","scene_source_sha256","source_version_id",
              "release_sha256","issue_code","message","severity","disposition",
              "global_seconds","window_ms","time_basis","human_review_required"],
            "properties": {
              "id": {"type": "string"},
              "scene_id": {"type": "string"},
              "scene_source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "source_version_id": {"type": ["string", "null"]},
              "release_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "issue_code": {"enum": ["PHASE_INVERTED_MONO_CANCELLATION","CHANNEL_SIGNAL_TOO_WEAK"]},
              "message": {"type": "string"},
              "severity": {"const": "high"},
              "disposition": {"const": "REVIEW_REQUIRED"},
              "global_seconds": {"type": "number", "minimum": 0},
              "window_ms": {"const": 300},
              "time_basis": {"const": "DECODED_PCM_WINDOW_APPROXIMATE_MP4_SEEK"},
              "human_review_required": {"const": true}
            }
          }
        }
      }
    },
    "real_audio_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state","source","release_sha256","receipt_sha256","findings",
        "time_basis","cryptographically_signed","verified_video_pts",
        "human_listening_verified","publication_allowed"],
      "properties": {
        "state": {"enum": ["NOT_CONNECTED","NOT_STARTED","QUEUED","RUNNING",
          "FAILED","STALE","REJECTED","COMPLETED_REVIEW_ONLY"]},
        "source": {"const": "M58_R20_REAL_MASTER_PCM"},
        "release_sha256": {"type": ["string","null"],"pattern": "^[a-f0-9]{64}$"},
        "receipt_sha256": {"type": ["string","null"],"pattern": "^[a-f0-9]{64}$"},
        "time_basis": {"const": "DECODED_PCM_SECONDS_APPROXIMATE_VIDEO_SEEK"},
        "cryptographically_signed": {"const": false},
        "verified_video_pts": {"const": false},
        "human_listening_verified": {"const": false},
        "publication_allowed": {"const": false},
        "findings": {
          "type": "array","maxItems": 200,
          "items": {"type": "object","additionalProperties": false,
            "required": ["id","issue_code","message","global_seconds",
              "window_end_seconds","time_basis","requires_human_review"],
            "properties": {
              "id": {"type": "string"},
              "issue_code": {"enum": ["POSSIBLE_MONO_FOLD_DOWN_CANCELLATION",
                "POSSIBLE_ONE_CHANNEL_DROPOUT","POSSIBLE_SILENT_AUDIO_TRACK"]},
              "message": {"type": "string"},
              "global_seconds": {"type": "number","minimum": 0},
              "window_end_seconds": {"type": "number","minimum": 0},
              "time_basis": {"const": "DECODED_PCM_SECONDS_APPROXIMATE_VIDEO_SEEK"},
              "requires_human_review": {"const": true}
            }
          }
        }
      }
    },
    "render_allowed": {
      "const": false
    },
    "publication_allowed": {
      "const": false
    },
    "snapshot_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
