{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pressbuilder.local/schemas/montage/media-catalog-v1.schema.json",
  "title": "M32 source-pinned media catalog v1",
  "description": "Operator-attested rights references for existing immutable P08 MP4 source versions. Catalog status does NOT certify legal rights or authorize output publication.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "revision",
    "assets"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project_id": {
      "$ref": "#/$defs/slug"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "assets": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/asset"
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,40}$"
    },
    "sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "utc": {
      "type": "string",
      "format": "date-time"
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "source_scene_id",
        "source_version_id",
        "source_sha256",
        "source_approval_revision",
        "label",
        "rights_holder",
        "license_ref",
        "evidence_ref",
        "expires_at",
        "allowed_uses",
        "allowed_scenes",
        "attribution",
        "kind",
        "status",
        "revision",
        "proposed_at",
        "proposed_by",
        "attested_at",
        "attested_by",
        "revoked_at",
        "revoked_by",
        "reason"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,48}$"
        },
        "source_scene_id": {
          "$ref": "#/$defs/slug"
        },
        "source_version_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{16}$"
        },
        "source_sha256": {
          "$ref": "#/$defs/sha"
        },
        "source_approval_revision": {
          "type": "integer",
          "minimum": 1
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "rights_holder": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "license_ref": {
          "type": "string",
          "minLength": 4,
          "maxLength": 160
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 4,
          "maxLength": 160
        },
        "expires_at": {
          "$ref": "#/$defs/utc"
        },
        "allowed_uses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "b_roll",
              "internal_preview",
              "composition",
              "research"
            ]
          }
        },
        "allowed_scenes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/slug"
          }
        },
        "attribution": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "kind": {
          "const": "approved_scene_mp4"
        },
        "status": {
          "type": "string",
          "enum": [
            "PENDING_ATTESTATION",
            "ATTESTED",
            "REVOKED"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "proposed_at": {
          "$ref": "#/$defs/utc"
        },
        "proposed_by": {
          "type": "string",
          "minLength": 1
        },
        "attested_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "attested_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "revoked_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "revoked_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
