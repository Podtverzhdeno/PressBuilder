{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PressBuilder Project Style Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "enforce",
    "palette",
    "typography",
    "safeArea",
    "camera",
    "motion",
    "transitions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "enforce": {
      "type": "boolean"
    },
    "palette": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^#[0-9a-fA-F]{6}$"
      }
    },
    "typography": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fonts",
        "minFontSize",
        "maxTextLength"
      ],
      "properties": {
        "fonts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "display",
              "sans",
              "mono"
            ]
          }
        },
        "minFontSize": {
          "type": "number",
          "minimum": 16,
          "maximum": 240
        },
        "maxTextLength": {
          "type": "number",
          "minimum": 1,
          "maximum": 250
        }
      }
    },
    "safeArea": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "left",
        "right",
        "top",
        "bottom"
      ],
      "properties": {
        "left": {
          "type": "number",
          "minimum": 32,
          "maximum": 400
        },
        "right": {
          "type": "number",
          "minimum": 32,
          "maximum": 400
        },
        "top": {
          "type": "number",
          "minimum": 32,
          "maximum": 400
        },
        "bottom": {
          "type": "number",
          "minimum": 100,
          "maximum": 400
        }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxYawSpeed",
        "maxPitchSpeed"
      ],
      "properties": {
        "maxYawSpeed": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "maxPitchSpeed": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5
        }
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxSpin"
      ],
      "properties": {
        "maxSpin": {
          "type": "number",
          "minimum": 0,
          "maximum": 4
        }
      }
    },
    "transitions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed",
        "maxDuration"
      ],
      "properties": {
        "allowed": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "hard-cut",
              "crossfade",
              "match-cut"
            ]
          }
        },
        "maxDuration": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.75
        }
      }
    },
    "sceneOverrides": {
      "type": "object",
      "maxProperties": 300,
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9_-]{0,40}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "palette": {
            "type": "array",
            "minItems": 1,
            "maxItems": 24,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            }
          },
          "minFontSize": {
            "type": "number",
            "minimum": 32,
            "maximum": 240
          },
          "safeArea": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "left": {
                "type": "number",
                "minimum": 32,
                "maximum": 400
              },
              "right": {
                "type": "number",
                "minimum": 32,
                "maximum": 400
              },
              "top": {
                "type": "number",
                "minimum": 32,
                "maximum": 400
              },
              "bottom": {
                "type": "number",
                "minimum": 100,
                "maximum": 400
              }
            }
          },
          "maxYawSpeed": {
            "type": "number",
            "minimum": 0,
            "maximum": 2
          },
          "maxPitchSpeed": {
            "type": "number",
            "minimum": 0,
            "maximum": 0.5
          },
          "maxSpin": {
            "type": "number",
            "minimum": 0,
            "maximum": 4
          },
          "maxTransitionDuration": {
            "type": "number",
            "minimum": 0,
            "maximum": 0.75
          }
        }
      }
    }
  }
}
